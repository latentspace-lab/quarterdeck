{
  "name": "segel-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "3D Sailing Simulator (Web-based) - Semi-realistic sailing physics with Freeride/Regatta/Training modes",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "build:shared": "npm run build -w @segel/shared",
    "build:server": "npm run build -w @segel/server",
    "build:client": "npm run build -w @segel/client",
    "build": "npm run build:shared && npm run build:client",
    "dev": "npm run dev -w @segel/client",
    "preview": "npm run preview -w @segel/client",
    "typecheck": "npm run build:shared --silent && npm run typecheck -w @segel/shared && npm run typecheck -w @segel/server",
    "server": "npm run start -w @segel/server",
    "server:headless": "npm run start:headless -w @segel/server",
    "test": "npm run build --silent && node tests/run.js",
    "test:unit": "npm run build:shared --silent && node tests/run.js --unit",
    "test:regression": "npm run build:shared --silent && node tests/run.js --regression",
    "test:integration": "npm run build --silent && node tests/run.js --integration",
    "test:pending": "npm run build:shared --silent && node tests/run.js --pending"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.2",
    "playwright": "^1.49.0",
    "typescript": "^5.9.3"
  }
}
