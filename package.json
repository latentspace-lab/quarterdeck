{
  "name": "quarterdeck",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "3D sailing simulator in the browser",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "build:shared": "npm run build -w @quarterdeck/shared",
    "build:server": "npm run build -w @quarterdeck/server",
    "build:client": "npm run build -w @quarterdeck/client",
    "build": "npm run build:shared && npm run build:client",
    "dev": "npm run dev -w @quarterdeck/client",
    "preview": "npm run preview -w @quarterdeck/client",
    "typecheck": "npm run build:shared --silent && npm run typecheck -w @quarterdeck/shared && npm run typecheck -w @quarterdeck/server",
    "server": "npm run start -w @quarterdeck/server",
    "server:headless": "npm run start:headless -w @quarterdeck/server",
    "test": "npm run build --silent && node tests/run.js",
    "test:unit": "npm run build:shared --silent && node tests/run.js --unit",
    "test:regression": "npm run build:shared --silent && node tests/run.js --regression",
    "test:integration": "npm run build --silent && node tests/run.js --integration",
    "test:pending": "npm run build:shared --silent && node tests/run.js --pending"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.2",
    "playwright": "^1.49.0",
    "typescript": "^5.7.2"
  }
}
